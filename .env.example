# Skopiuj do .env i uzupełnij. Schemat i walidacja: astro.config.mjs → env.schema (astro:env).
# Do Fazy 5 wszystkie zmienne są opcjonalne.

# Resend — wysyłka wiadomości z formularza kontaktowego (Faza 5)
RESEND_API_KEY=
# Cloudflare Turnstile — sekret do weryfikacji po stronie serwera (Faza 5)
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile — publiczny site key widżetu (Faza 5)
PUBLIC_TURNSTILE_SITE_KEY=
# Adres, na który trafiają wiadomości z formularza (Faza 5)
CONTACT_TO_EMAIL=
# GitHub fine-grained token, read-only, public repos — dane GitHub przy buildzie (Faza 8). Brak = fallback.
GITHUB_TOKEN=
