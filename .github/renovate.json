{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Warsaw",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "astro",
      "matchPackageNames": ["astro", "@astrojs/**", "astro-*"]
    },
    {
      "groupName": "eslint + prettier",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "eslint-*",
        "typescript-eslint",
        "prettier",
        "prettier-*",
        "globals"
      ]
    },
    {
      "groupName": "testy",
      "matchPackageNames": ["vitest", "@playwright/test", "@axe-core/**", "@lhci/**"]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "prettier-plugin-tailwindcss"]
    },
    {
      "description": "Automerge patchy devDependencies, dopiero 3 dni po publikacji (czas na wycofanie złośliwej wersji)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "TS 7 czeka na wsparcie w @astrojs/check i typescript-eslint (DECISIONS #2)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
