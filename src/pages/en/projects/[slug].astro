---
import ProjectPage from '@/components/project/ProjectPage.astro';
import { loadProjects } from '@/lib/load-projects';
import type { Project } from '@/lib/projects';

export async function getStaticPaths() {
  const all = await loadProjects();
  return all.map((project) => ({ params: { slug: project.slug }, props: { project, all } }));
}

interface Props {
  project: Project;
  all: Project[];
}

const { project, all } = Astro.props;
---

<ProjectPage project={project} all={all} locale="en" />
