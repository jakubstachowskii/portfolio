---
import Container from '@/components/ui/Container.astro';
import ProjectWindow from '@/components/ui/ProjectWindow.astro';
import Stage from '@/components/ui/Stage.astro';

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<Stage labelledby={id}>
  <Container width="stage">
    <ProjectWindow title="kalkulator-mebli">
      <div class="grid h-40 place-items-center font-mono text-mono-sm text-dim">
        TODO(content): zrzut ekranu ≥ 2400 px
      </div>
    </ProjectWindow>
    <div class="mt-6 flex flex-col gap-1">
      <p class="font-mono text-mono text-accent-text">web · single-page</p>
      <h2 id={id} class="text-h2">
        Kalkulator mebli
      </h2>
      <p class="max-w-(--measure-caption) text-body-lg text-muted">
        Rozkrój mebli, rysunek, lista rozkroju i PDF dla stolarni.
      </p>
    </div>
  </Container>
</Stage>
