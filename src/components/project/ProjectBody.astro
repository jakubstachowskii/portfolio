---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Locale } from '@/config/site';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  gallery: ImageMetadata[];
  title: string;
  /** czy jest treść markdown (slot) */
  hasBody: boolean;
}

const { locale, gallery, title, hasBody } = Astro.props;
const d = t(locale).project;
// Treść z pliku nadpisania (markdown) + galeria. Bez obu sekcja się nie renderuje.
---

{(hasBody || gallery.length > 0) && (
  <section class="wrap body reveal">
    {hasBody && (
      <div class="prose">
        <slot />
      </div>
    )}
    {gallery.length > 0 && (
      <div class="gallery">
        <h2 class="mono gtitle">{d.gallery}</h2>
        <div class="grid">
          {gallery.map((img, i) => (
            <Image
              src={img}
              alt={`${title} — ${i + 1}`}
              widths={[480, 960]}
              sizes="(max-width: 900px) 100vw, 560px"
            />
          ))}
        </div>
      </div>
    )}
  </section>
)}

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-top: 72px;
  }
  /* czytelna kolumna: ~68 znaków, kolor drugorzędny, nagłówki w Archivo */
  .prose {
    max-width: 68ch;
    color: var(--text2);
    font-size: 17px;
    line-height: 1.7;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin: 2em 0 0.6em;
    color: var(--text);
    font-family: var(--font-disp);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .prose :global(h2) {
    font-size: 24px;
  }
  .prose :global(h3) {
    font-size: 18px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
  }
  .prose :global(a) {
    color: var(--acc-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    font-family: var(--font-code);
    font-size: 0.9em;
    color: var(--text3);
  }
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gtitle {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--acc-text);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .grid :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
