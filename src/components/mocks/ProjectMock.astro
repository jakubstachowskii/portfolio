---
/*
 * Szkic projektu w podglądzie. Zasada dla każdego szkicu (nowy = nowy plik w tym katalogu + wpis w MOCKS
 * w src/lib/projects.ts + `mock: nazwa` w nadpisaniu repo):
 * - ramka 1px var(--line2), tło var(--surface), tekst mono 11px, szerokość ~74–78% sceny;
 * - akcent (var(--acc)) tylko na jednym elemencie, reszta kolorów z var(--hue1–5) i var(--line*);
 * - jedna delikatna animacja w pętli, czas z tokenów (--t-*), pauzowana poza ekranem (klasa .off);
 * - napisy przez i18n (`home.mocks`), bez wymyślonych danych.
 */
import Awizacja from './Awizacja.astro';
import Formatka from './Formatka.astro';
import Generic from './Generic.astro';
import Lotto from './Lotto.astro';
import Pig from './Pig.astro';
import type { Dictionary } from '@/i18n/utils';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  m: Dictionary['home']['mocks'];
}

const { project, m } = Astro.props;
---

{project.mock === 'awizacja' && <Awizacja m={m} />}
{project.mock === 'formatka' && <Formatka />}
{project.mock === 'lotto' && <Lotto m={m} />}
{project.mock === 'pig' && <Pig m={m} />}
{project.mock === 'generic' && <Generic title={project.title} />}
