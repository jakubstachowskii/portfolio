---
interface Props {
  title: string;
  tags: string[];
}

const { title, tags } = Astro.props;
// Szkic dla repo bez własnego: okno z nazwą i technologiami (w stylu szkiców wzorca)
---

<div class="win mono">
  <div class="dots">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="body">
    <span class="name">{title.toUpperCase()}</span>
    <span class="ln w80"></span>
    <span class="ln w60"></span>
    <div class="chips">
      {tags.slice(0, 3).map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .win {
    position: relative;
    width: 74%;
    background: var(--surface);
    border: 1px solid var(--line2);
    font-size: 11px;
  }
  .dots {
    display: flex;
    gap: 5px;
    padding: 8px 9px;
    border-bottom: 1px solid var(--line);
  }
  .dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line2);
  }
  .body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .name {
    color: var(--text2);
  }
  .ln {
    height: 8px;
    background: var(--line);
  }
  .w80 {
    width: 80%;
  }
  .w60 {
    width: 60%;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    padding: 3px 8px;
    border: 1px solid var(--acc);
    background: var(--acc-soft);
  }
</style>
