---
import type { Locale } from '@/config/site';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const dict = t(Astro.props.locale);
// Ikona zależy od data-theme (CSS), więc jest poprawna od pierwszej klatki, także bez JS.
---

<button
  type="button"
  class="tbtn"
  data-theme-toggle
  data-label-light={dict.ui.theme.toLight}
  data-label-dark={dict.ui.theme.toDark}
  aria-label={dict.ui.theme.toLight}
  title={dict.ui.theme.toLight}
>
  <svg
    class="ic-sun"
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="ic-moon"
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
  </svg>
</button>

<script>
  import { initThemeToggle } from '@/scripts/theme-toggle';
  initThemeToggle();
</script>

<style>
  .tbtn {
    width: var(--target);
    height: var(--target);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition:
      background-color var(--t-fast),
      border-color var(--t-fast);
  }
  .tbtn:hover {
    border-color: var(--acc);
  }
  /* ciemny motyw → słońce (przejście na jasny), jasny → księżyc */
  .ic-moon,
  :global([data-theme='light']) .ic-sun {
    display: none;
  }
  :global([data-theme='light']) .ic-moon {
    display: block;
  }
  svg {
    animation: spin var(--t-row) cubic-bezier(0.3, 1.5, 0.5, 1) both;
  }
  @keyframes spin {
    from {
      opacity: 0;
      rotate: -120deg;
      scale: 0.4;
    }
  }
</style>
