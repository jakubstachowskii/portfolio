---
import HeroDeck from './HeroDeck.astro';
import { site, type Locale } from '@/config/site';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = t(locale).home.hero;
const last = h.lines.length - 1;
// ostatnie słowo statusu łamie się razem z rokiem („PROJEKTY · 2026”), żeby rok nie został sam
const statusWords = h.status.split(' ');
const statusTail = statusWords.pop() ?? '';
const statusHead = statusWords.length ? `${statusWords.join(' ')} ` : '';
---

<section id="top" class="hero">
  <div class="grid" aria-hidden="true"></div>
  <div class="wrap split body">
    <div class="copy">
      <div class="in d1 mono status">
        <span class="dotlive" aria-hidden="true"></span>
        <span>
          {statusHead}
          <span class="nowrap">{`${statusTail} · ${site.year}`}</span>
        </span>
      </div>
      <h1 class="disp title">
        {h.lines.map((line, i) => (
          <span class:list={['line', i > 0 && `l${i + 1}`]}>
            <span class:list={[i === last && 'acc']}>{line}</span>
          </span>
        ))}
      </h1>
      <p class="in d3 lead">{h.lead}</p>
      <div class="in d4 ctas">
        <a class="btn btn-acc mono cta cta-acc" href="#projekty">
          {h.ctaProjects}
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"
          >
            <path d="M12 5v14"></path>
            <path d="m19 12-7 7-7-7"></path>
          </svg>
        </a>
        <a
          class="btn mono cta cta-line"
          href={`https://github.com/${site.github}`}
          target="_blank"
          rel="noopener"
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m16 18 6-6-6-6"></path>
            <path d="m8 6-6 6 6 6"></path>
          </svg>
          {h.ctaGithub}
        </a>
        {/* CV pokazuje się dopiero po ustawieniu `cv` w site.ts (bez martwego linku) */}
        {site.cv && (
          <a class="btn mono cta cta-ghost" href={site.cv}>
            {h.ctaCv}
          </a>
        )}
      </div>
    </div>
    <div class="art">
      <HeroDeck locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 80px 80px;
    opacity: 0.35;
    -webkit-mask-image: linear-gradient(180deg, black, transparent 85%);
    mask-image: linear-gradient(180deg, black, transparent 85%);
  }
  .body {
    position: relative;
    padding-top: 96px;
    padding-bottom: 104px;
    align-items: center;
  }
  .copy {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border: 1px solid var(--line2);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--text3);
  }
  .title {
    margin: 0;
    font-size: clamp(36px, 7.6vw, 108px);
    line-height: 0.96;
  }
  .nowrap {
    white-space: nowrap;
  }
  .acc {
    color: var(--acc-text);
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .line > span {
    display: inline-block;
    animation: lineUp var(--t-line) var(--ease-line) both;
  }
  .l2 > span {
    animation-delay: 0.12s;
  }
  .l3 > span {
    animation-delay: 0.24s;
  }
  @keyframes lineUp {
    from {
      translate: 0 105%;
    }
    to {
      translate: 0 0;
    }
  }
  .lead {
    margin: 0;
    max-width: 520px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    font-size: 14px;
    font-weight: 500;
  }
  .cta-acc {
    background: var(--acc);
    color: var(--acc-ink);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .cta-line {
    border: 1px solid var(--line2);
    color: var(--text);
  }
  .cta-ghost {
    color: var(--text2);
  }
  .art {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
</style>
