---
import type { Locale } from '@/config/site';
import { t } from '@/i18n/utils';
import type { Contributions } from '@/lib/contributions';
import { fill } from '@/lib/format';

interface Props {
  data: Contributions;
  locale: Locale;
}

const { data, locale } = Astro.props;
const d = t(locale).home.gh;
const label = fill(d.calendar, { total: data.total, weeks: data.weeks.length });
// Kolumny = tygodnie, wiersze = dni. Opóźnienie fali jak we wzorcu (kolumna × 0,06 s + wiersz × 0,03 s).
const cells = data.weeks.flatMap((week, c) =>
  week.map((day, r) => ({ ...day, delay: (c * 0.06 + r * 0.03).toFixed(2) })),
);
---

<figure class="cal">
  <div class="grid" role="img" aria-label={label}>
    {cells.map((cell) => (
      <span
        class={`wave l${cell.level}`}
        style={`animation-delay: ${cell.delay}s`}
        title={`${cell.date}: ${cell.count}`}
      />
    ))}
  </div>
  <figcaption class="mono legend" aria-hidden="true">
    <span>{d.less}</span>
    {[0, 1, 2, 3, 4].map((l) => (
      <span class={`key l${l}`} />
    ))}
    <span>{d.more}</span>
  </figcaption>
</figure>

<style>
  .cal {
    flex: 2 1 560px;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .grid {
    display: grid;
    grid-template-rows: repeat(7, 12px);
    grid-auto-flow: column;
    grid-auto-columns: 12px;
    gap: 4px;
  }
  /* siatka się nie mieści (WEEKS = 44: 44 × 12px + 43 × 4px = 700px): wyrównanie do prawej,
     ucinają się najstarsze tygodnie, nie najnowsze; gdy się mieści, zostaje przy lewej jak we wzorcu */
  @container (max-width: 699px) {
    .grid {
      justify-content: end;
    }
  }
  .l0 {
    background: var(--cell);
  }
  .l1 {
    background: var(--cell-1);
  }
  .l2 {
    background: var(--cell-2);
  }
  .l3 {
    background: var(--cell-3);
  }
  .l4 {
    background: var(--cell-4);
  }
  /* fala: jedno przejście, gdy sekcja wejdzie w widok (klasa .seen); przezroczystość nakładki (GPU) */
  .wave {
    position: relative;
  }
  .wave::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cell-hi);
    opacity: 0;
  }
  :global(.seen) .wave::after {
    animation: wave var(--t-wave) ease-in-out both;
    animation-delay: inherit;
  }
  @keyframes wave {
    0%,
    30%,
    100% {
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
  }
  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 11px;
    color: var(--text2);
  }
  .legend span:first-child {
    margin-right: 4px;
  }
  .legend span:last-child {
    margin-left: 4px;
  }
  .key {
    width: 12px;
    height: 12px;
  }
</style>
