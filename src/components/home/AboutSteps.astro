---
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="cols3 reveal">
  {steps.map((s, i) => (
    <li>
      <span class="disp n">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="disp ttl">{s.title}</h3>
      <p class="txt">{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .cols3 {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }
  li {
    background: var(--bg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .n {
    font-size: 44px;
    line-height: 1;
    color: var(--acc-text);
  }
  .ttl {
    margin: 0;
    font-size: 18px;
  }
  .txt {
    margin: 0;
    color: var(--text2);
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .cols3 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
