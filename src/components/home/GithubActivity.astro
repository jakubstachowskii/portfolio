---
import GithubCalendar from './GithubCalendar.astro';
import { site, type Locale } from '@/config/site';
import { t } from '@/i18n/utils';
import type { Contributions } from '@/lib/contributions';
import { formatDate, plural } from '@/lib/format';

interface Props {
  locale: Locale;
  data: Contributions;
}

const { locale, data } = Astro.props;
const d = t(locale).home.gh;
// Renderowana tylko z danymi z GitHub GraphQL (HomePage: bez tokenu sekcji nie ma).
---

<section id="gh" class="gh" aria-label={d.label} data-gh>
  <div class="wrap reveal row">
    <div class="copy">
      <span class="mono kicker">{d.kicker}</span>
      <h2 class="disp ttl">
        {d.title[0]}
        <br />
        {d.title[1]}
      </h2>
      <ul class="mono facts">
        <li>
          <a
            class="mail"
            href={`https://github.com/${site.github}?tab=repositories`}
            target="_blank"
            rel="noopener"
          >
            {plural(data.publicRepos, d.repos, locale)}
          </a>
        </li>
        {data.lastCommit && (
          <li>
            {`${d.lastCommit}: `}
            <time datetime={data.lastCommit}>{formatDate(data.lastCommit, locale)}</time>
          </li>
        )}
      </ul>
    </div>
    <GithubCalendar data={data} locale={locale} />
  </div>
</section>

<script>
  // fala w siatce jako animacja wejścia: jedno przejście, gdy sekcja pierwszy raz pojawi się na ekranie
  const gh = document.querySelector<HTMLElement>('[data-gh]');
  if (gh && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        gh.classList.add('seen');
        io.disconnect();
      },
      { threshold: 0.3 },
    );
    io.observe(gh);
  }
</script>

<style>
  .gh {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg2);
    padding: 80px 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
  }
  .copy {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .kicker {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--acc-text);
  }
  .ttl {
    margin: 0;
    font-size: 34px;
    line-height: 1.02;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--text2);
  }
  .facts a {
    color: var(--text);
  }
</style>
