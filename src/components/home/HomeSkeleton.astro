---
import { sections, site, type Locale } from '@/config/site';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const dict = t(Astro.props.locale);
// Etap 1: puste sekcje z docelowymi id (nawigacja, kreski, skip link). Treść = Etap 2.
---

{sections.map((id) => (
  <section id={id} class="stub" aria-label={dict.dots.items[id]}>
    <div class="wrap">
      {id === 'top' ? (
        <h1 class="disp title">{site.firstName}</h1>
      ) : (
        <p class="mono label">{dict.dots.items[id]}</p>
      )}
    </div>
  </section>
))}

<style>
  .stub {
    min-height: 80vh;
    padding: 120px 0;
    border-bottom: 1px solid var(--line);
  }
  .title {
    margin: 0;
    font-size: clamp(48px, 9vw, 128px);
    line-height: 0.92;
  }
  .label {
    font-size: 13px;
    color: var(--text2);
  }
</style>
