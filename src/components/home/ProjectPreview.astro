---
import ProjectFacts from '@/components/project/ProjectFacts.astro';
import ProjectStage from '@/components/project/ProjectStage.astro';
import type { Locale } from '@/config/site';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  locale: Locale;
  hidden?: boolean;
}

const { project: p, locale, hidden = false } = Astro.props;
---

<article class="pv pva card" hidden={hidden} data-preview={p.id}>
  <ProjectStage project={p} locale={locale} />
  <div class="info">
    <div class="titles">
      <span class="mono plat">{p.platforms}</span>
      <h3 class="disp name">{p.title}</h3>
    </div>
    <p class="desc">{p.desc[locale]}</p>
    <ProjectFacts project={p} locale={locale} details />
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .card[hidden] {
    display: none;
  }
  .info {
    padding: 26px 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .plat {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--acc-text);
  }
  .name {
    margin: 0;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .desc {
    margin: 0;
    color: var(--text2);
  }
</style>
