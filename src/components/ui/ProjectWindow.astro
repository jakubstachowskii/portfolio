---
interface Props {
  /** Tekst paska tytułu (mono), np. nazwa pliku/aplikacji. */
  title: string;
  class?: string;
}

const { title, class: extra } = Astro.props;
---

<!-- Okno aplikacji: rama dla zrzutu projektu (DESIGN.md §8). Zawartość: <Picture> w slocie. -->
<div
  data-project-window
  class={[
    'relative z-1 mx-auto w-full max-w-stage overflow-hidden rounded-lg border border-line bg-window shadow-key-stage',
    'transition-colors duration-(--duration-base) ease-out is-hover:border-line-strong',
    extra,
  ].join(' ')}
>
  <div class="flex h-(--size-window-bar) items-center gap-1 border-b border-line px-2 font-mono text-mono-sm text-dim">
    <span class="flex gap-1" aria-hidden="true">
      <span class="size-1.25 rounded-pill bg-line-strong"></span>
      <span class="size-1.25 rounded-pill bg-line-strong"></span>
      <span class="size-1.25 rounded-pill bg-line-strong"></span>
    </span>
    <span class="ml-1 truncate">{title}</span>
  </div>
  <div class="relative">
    <slot />
  </div>
</div>
