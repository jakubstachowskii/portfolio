---
interface Props {
  /** Klasy wymiarów z tokenów, np. "h-3 w-24". */
  class?: string;
}
const { class: extra } = Astro.props;
---

<div class={['skeleton rounded-sm bg-band', extra].join(' ')} aria-hidden="true"></div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .skeleton {
      background-image: linear-gradient(90deg, transparent, var(--color-line) 50%, transparent);
      background-size: 200% 100%;
      animation: shimmer var(--duration-pulse) var(--ease-out) infinite;
    }
  }
  @keyframes shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }
</style>
