---
type State = 'hover' | 'focus' | 'active' | 'disabled';

interface Props {
  as?: 'article' | 'div' | 'li' | 'section';
  interactive?: boolean;
  state?: State | undefined;
  class?: string;
}

const { as: Tag = 'div', interactive = false, state, class: extra } = Astro.props;
---

<Tag
  class={[
    'rounded-md border border-line bg-surface p-3 shadow-key',
    interactive &&
      'transition duration-(--duration-base) ease-out is-hover:border-line-strong is-hover:-translate-y-0.25',
    extra,
  ]
    .filter(Boolean)
    .join(' ')}
  data-state={state}
>
  <slot />
</Tag>
