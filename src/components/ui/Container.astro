---
interface Props {
  width?: 'content' | 'stage' | 'palette';
  as?: 'div' | 'section' | 'header' | 'footer' | 'main';
  class?: string;
}

const { width = 'content', as: Tag = 'div', class: extra } = Astro.props;
const max = { content: 'max-w-content', stage: 'max-w-stage', palette: 'max-w-palette' } as const;
---

<!-- gutter 16 / 24 / 32 px (DESIGN.md §5.3) -->
<Tag class={['mx-auto w-full px-2 md:px-3 xl:px-4', max[width], extra].join(' ')}>
  <slot />
</Tag>
