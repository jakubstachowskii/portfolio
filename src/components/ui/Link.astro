---
import { Icon } from 'astro-icon/components';
import { localeOf, t } from '@/i18n/utils';

interface Props {
  href: string;
  /** Domyślnie wykrywane z adresu (http/https). */
  external?: boolean;
  tone?: 'default' | 'accent';
  class?: string;
}

const { href, external = /^https?:\/\//.test(href), tone = 'default', class: extra } = Astro.props;
const dict = t(localeOf(Astro));
---

<a
  href={href}
  rel={external ? 'external noopener' : undefined}
  class={[
    'inline-flex items-center gap-0.5 underline decoration-line-strong underline-offset-4 transition-colors duration-(--duration-fast)',
    'is-hover:decoration-current',
    tone === 'accent' ? 'text-accent-text' : 'text-fg',
    extra,
  ].join(' ')}
>
  <slot />
  {external && (
    <>
      <Icon name="lucide:arrow-up-right" class="size-2" aria-hidden="true" />
      <span class="sr-only">{dict.ui.link.external}</span>
    </>
  )}
</a>
