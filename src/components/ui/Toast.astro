---
import { Icon } from 'astro-icon/components';
import { localeOf, t } from '@/i18n/utils';
import IconButton from './IconButton.astro';

interface Props {
  tone?: 'info' | 'success' | 'danger';
  class?: string;
}

const { tone = 'info', class: extra } = Astro.props;
const dict = t(localeOf(Astro));
const icon = {
  info: 'lucide:info',
  success: 'lucide:check',
  danger: 'lucide:triangle-alert',
} as const;
const color = { info: 'text-accent-text', success: 'text-success', danger: 'text-danger' } as const;
---

<!-- Wygląd + semantyka. Pokazywanie/ukrywanie (kolejka, auto-hide 4 s, pauza na hover) w Fazie 8. -->
<div
  role="status"
  aria-live="polite"
  class={[
    'flex max-w-palette items-center gap-2 rounded-md border border-line bg-surface py-1 pr-1 pl-2 text-ui-sm text-fg shadow-key-stage',
    extra,
  ].join(' ')}
>
  <Icon name={icon[tone]} class={`size-2.5 shrink-0 ${color[tone]}`} aria-hidden="true" />
  <p class="flex-1">
    <slot />
  </p>
  <IconButton label={dict.ui.toast.close} variant="ghost">
    <Icon name="lucide:x" class="size-2" aria-hidden="true" />
  </IconButton>
</div>
