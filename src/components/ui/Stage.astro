---
interface Props {
  /** Podpis wyrównany do prawej (co druga scena). */
  flip?: boolean;
  labelledby?: string;
  class?: string;
}

const { flip = false, labelledby, class: extra } = Astro.props;
---

<!-- Scena projektu: snop światła + siatka widoczna tylko w świetle (DESIGN.md §2, §7). -->
<section
  data-stage
  data-flip={flip}
  aria-labelledby={labelledby}
  class={['stage relative pt-12 pb-16', extra].join(' ')}
>
  <div class="light" aria-hidden="true"></div>
  <div class="grid-light" aria-hidden="true"></div>
  <div class="scene relative">
    <slot />
  </div>
</section>

<style>
  .stage {
    /* clip, nie hidden: hidden tworzy scroller i psuje animation-timeline: view() (DESIGN.md §7.3) */
    overflow: clip;
    --mx: 50%;
    --my: 40%;
  }
  .light,
  .grid-light {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .light {
    background: radial-gradient(46% 58% at var(--mx) var(--my), var(--color-spot), transparent 70%);
  }
  .grid-light {
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: calc(var(--spacing) * 4) calc(var(--spacing) * 4);
    mask-image: radial-gradient(38% 48% at var(--mx) var(--my), black, transparent 75%);
  }
  .scene {
    perspective: var(--stage-perspective);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stage {
        view-timeline: --scene block;
      }
      .light,
      .grid-light {
        animation: ignite linear both;
        animation-timeline: --scene;
        animation-range: entry 10% cover 50%;
      }
      .stage :global([data-project-window]) {
        transform-origin: 50% 100%;
        animation: lift linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 42%;
      }
    }
  }
  @keyframes ignite {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @keyframes lift {
    from {
      transform: translateY(calc(var(--spacing) * 12)) rotateX(var(--stage-tilt)) scale(0.9);
      opacity: 0.25;
      filter: brightness(0.5);
    }
  }
</style>

<script>
  import { initSpotlight } from '@/scripts/spotlight';
  initSpotlight();
</script>
