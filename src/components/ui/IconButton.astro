---
type State = 'hover' | 'focus' | 'active' | 'disabled';

interface Props {
  /** Wymagana etykieta dla czytników ekranu (zawsze z i18n). */
  label: string;
  variant?: 'secondary' | 'ghost';
  href?: string;
  disabled?: boolean;
  state?: State | undefined;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  label,
  variant = 'secondary',
  href,
  disabled = false,
  state,
  class: extra,
  ...data
} = Astro.props;

const classes = [
  'inline-grid size-(--size-target) place-items-center rounded-pill text-fg',
  'transition duration-(--duration-base) ease-out is-active:scale-98',
  'is-disabled:opacity-50 is-disabled:cursor-not-allowed',
  variant === 'secondary'
    ? 'bg-surface border border-line shadow-key is-hover:border-line-strong is-active:shadow-key-pressed'
    : 'is-hover:bg-band',
  extra,
].join(' ');
---

{href && !disabled ? (
  <a href={href} class={classes} aria-label={label} data-state={state} {...data}>
    <slot />
  </a>
) : (
  <button
    type="button"
    class={classes}
    aria-label={label}
    disabled={disabled}
    data-state={state}
    {...data}
  >
    <slot />
  </button>
)}
