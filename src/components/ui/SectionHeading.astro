---
interface Props {
  title: string;
  /** Mono, małe litery, w kolorze akcentu. Bez numeracji, chyba że treść jest sekwencją (DESIGN.md §8). */
  kicker?: string;
  level?: 'h2' | 'h3';
  id?: string;
  class?: string;
}

const { title, kicker, level: Heading = 'h2', id, class: extra } = Astro.props;
---

<header class={['flex flex-col gap-1', extra].join(' ')}>
  {kicker && <p class="font-mono text-mono text-accent-text">{kicker}</p>}
  <Heading id={id} class="text-h3 text-fg">
    {title}
  </Heading>
</header>
