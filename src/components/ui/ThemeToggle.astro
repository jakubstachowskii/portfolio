---
import { Icon } from 'astro-icon/components';
import { localeOf, t } from '@/i18n/utils';
import IconButton from './IconButton.astro';

const dict = t(localeOf(Astro));
---

<!-- Etykieta opisuje akcję (przełącza na przeciwny motyw); aktualizuje ją skrypt. -->
<IconButton
  class="toggle"
  label={dict.ui.theme.toLight}
  data-theme-toggle=""
  data-label-light={dict.ui.theme.toLight}
  data-label-dark={dict.ui.theme.toDark}
>
  <Icon name="lucide:sun" class="icon-sun size-2.5" aria-hidden="true" />
  <Icon name="lucide:moon" class="icon-moon size-2.5" aria-hidden="true" />
</IconButton>

<style>
  /* Ikona wynika z najbliższego [data-theme] (zmienne --toggle-* w tokens.css), więc działa też w panelach /design */
  .toggle :global(.icon-sun) {
    display: var(--toggle-sun);
  }
  .toggle :global(.icon-moon) {
    display: var(--toggle-moon);
  }
</style>

<script>
  import { THEME_STORAGE_KEY, isTheme, nextTheme } from '@/lib/theme';

  const label = (button: HTMLElement, current: string) => {
    const text = current === 'dark' ? button.dataset['labelLight'] : button.dataset['labelDark'];
    if (text) button.setAttribute('aria-label', text);
  };

  for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    const root = document.documentElement;
    label(button, root.dataset['theme'] ?? 'dark');
    button.addEventListener('click', () => {
      const current = root.dataset['theme'];
      const next = nextTheme(isTheme(current) ? current : 'dark');
      root.dataset['theme'] = next;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        /* tryb prywatny: motyw działa do końca sesji strony */
      }
      label(button, next);
    });
  }
</script>
