---
import { locales, type Locale } from '@/config/site';
import { localeOf, t } from '@/i18n/utils';
import { getLocalizedPath } from '@/lib/paths';

const current = localeOf(Astro);
const target = locales.find((l) => l !== current) as Locale;
const dict = t(current);
// Mapa slugów (projekty ↔ projects) dochodzi w Fazie 6 — getLocalizedPath ją przejmie.
const href = getLocalizedPath(Astro.url.pathname, target);
---

<a
  href={href}
  hreflang={target}
  lang={target}
  aria-label={dict.ui.lang.switchLabel}
  class="inline-grid min-h-(--size-target) min-w-(--size-target) place-items-center rounded-pill border border-line bg-surface px-1.5 font-mono text-mono-sm text-fg shadow-key transition duration-(--duration-base) ease-out is-hover:border-line-strong"
>
  {dict.ui.lang.short}
</a>
