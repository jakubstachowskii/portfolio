---
import { localeOf, t } from '@/i18n/utils';

type ProjectStatus = 'live' | 'in-progress' | 'archived';

interface Props {
  /** Gdy podany: tag statusu projektu z kropką i tekstem z i18n. */
  status?: ProjectStatus;
  class?: string;
}

const { status, class: extra } = Astro.props;
const dict = t(localeOf(Astro));
const dotColor: Record<ProjectStatus, string> = {
  live: 'bg-success',
  'in-progress': 'bg-accent',
  archived: 'bg-dim',
};
---

<span
  class={[
    'inline-flex items-center gap-0.5 rounded-sm border border-line px-1 py-0.25 font-mono text-mono-sm text-muted',
    extra,
  ].join(' ')}
>
  {status && (
    <span class={`size-(--size-dot) rounded-pill ${dotColor[status]}`} aria-hidden="true" />
  )}
  {status ? dict.ui.projectStatus[status] : <slot />}
</span>
