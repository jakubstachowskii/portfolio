---
interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: extra } = Astro.props;
const sizes = { sm: 'px-0.5 text-mono-sm', md: 'px-1 py-0.25 text-mono-sm' } as const;
---

<kbd
  class={[
    'inline-block min-w-3 rounded-sm border border-line bg-surface text-center font-mono text-fg shadow-key',
    sizes[size],
    extra,
  ].join(' ')}
>
  <slot />
</kbd>
