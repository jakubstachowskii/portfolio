---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import ThemeScript from '@/components/layout/ThemeScript.astro';
import type { Locale } from '@/config/site';
import { site } from '@/config/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
// Preload tylko krojów pierwszego ekranu (PLAN §11: ≤ 2 rodziny), mono ładuje się z font-display: swap.
const preloadText = [{ style: 'normal', subset: 'latin' }];
// latin-ext (polskie znaki) dociąga się przez unicode-range — małe pliki, DECISIONS #21
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Favicon dochodzi w Fazie 7; pusty data URI zapobiega 404 na /favicon.ico -->
    <link rel="icon" href="data:," />
    <Font cssVariable="--font-funnel-display" preload={preloadText} />
    <Font cssVariable="--font-funnel-sans" preload={preloadText} />
    <Font cssVariable="--font-geist-mono" />
    <meta name="description" content={description} />
    <title>{`${title} — ${site.name}`}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
