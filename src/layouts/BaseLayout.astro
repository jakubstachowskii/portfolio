---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Nav from '@/components/layout/Nav.astro';
import SectionDots from '@/components/layout/SectionDots.astro';
import Seo from '@/components/layout/Seo.astro';
import ThemeScript from '@/components/layout/ThemeScript.astro';
import type { Locale } from '@/config/site';
import { pageTitle } from '@/lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Strona główna: kotwice sekcji bez adresu + boczne kreski sekcji. */
  onHome?: boolean;
  noindex?: boolean;
  /** ścieżki tej strony w obu językach (hreflang) */
  alternates?: Partial<Record<Locale, string>> | undefined;
  /** dane strukturalne JSON-LD */
  jsonLd?: object | undefined;
}

const {
  locale,
  title,
  description,
  onHome = false,
  noindex = false,
  alternates,
  jsonLd,
} = Astro.props;
const fullTitle = pageTitle(title, onHome);
// Preload tylko krojów pierwszego ekranu (≤ 2 rodziny): łacina + polskie litery (~3 KB), DECISIONS #29.
// Mono ładuje się z font-display: swap.
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1efe9" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <Seo
      locale={locale}
      title={fullTitle}
      description={description}
      alternates={alternates}
      jsonLd={jsonLd}
      type={onHome ? 'website' : 'article'}
      noindex={noindex}
    />
  </head>
  <body>
    <Nav locale={locale} onHome={onHome} />
    {onHome && <SectionDots locale={locale} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} onHome={onHome} />
  </body>
</html>
